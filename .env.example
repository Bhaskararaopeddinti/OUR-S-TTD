# Database Configuration
# IMPORTANT: In production (Render), DATABASE_URL must be set to Supabase PostgreSQL
# For local development (SQLite):
DATABASE_URL=sqlite:///./ours_ttd.db

# For production (PostgreSQL/Supabase):
# DATABASE_URL=postgresql://username:password@host:port/database
# Example: DATABASE_URL=postgres://postgres.qzrqbzqx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Application Secrets
SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=*

# API Keys
GEMINI_API_KEY=your-gemini-api-key-here
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
